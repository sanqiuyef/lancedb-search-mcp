{
  "mcpServers": {
    "lancedb-search": {
      "description": "LanceDB knowledge search (fully local: bge-m3 + bge-reranker)",
      "command": "python",
      "args": [
        "-X",
        "utf8",
        "D:\\path\\to\\lancedb-search-mcp\\server.py"
      ],
      "env": {
        "LANCEDB_OCR": "1",
        "TESSERACT_CMD": "D:\\path\\to\\tesseract.exe",
        "LANCEDB_OCR_LANG": "chi_sim+eng",
        "HF_HOME": "D:\\huggingface",
        "HF_HUB_CACHE": "D:\\huggingface\\hub",
        "KMP_DUPLICATE_LIB_OK": "TRUE",
        "LANCEDB_DB_PATH": "D:\\cherry-workplace\\knowledge-hub\\lancedb"
      }
    }
  }
}